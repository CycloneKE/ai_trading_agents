{
  "primary_llm_provider": "gemini",
  "gemini_model": "gemini-2.0-flash",
  "llm_cooldown_seconds": 60,
  "sector_analysis_interval": 390,
  "data_manager": {
    "symbols": [
      "AAPL",
      "GOOGL",
      "MSFT",
      "TSLA",
      "NVDA",
      "SPY",
      "QQQ",
      "XLF",
      "XLV",
      "XLE",
      "BTC-USD",
      "ETH-USD",
      "SOL-USD"
    ],
    "crypto_symbols": [
      "BTC-USD",
      "ETH-USD",
      "SOL-USD"
    ],
    "nse_symbols": [
      "SCOM",
      "EQTY",
      "KCB",
      "COOP",
      "SCBK",
      "ABSA",
      "BAT",
      "EABL",
      "NCBA"
    ],
    "update_interval": 60,
    "max_retries": 3,
    "redis": {
      "host": "localhost",
      "port": 6379,
      "db": 0
    },
    "connectors": {
      "coinbase": {
        "enabled": true
      },
      "fmp": {
        "enabled": true,
        "api_key": "${TRADING_FMP_API_KEY}"
      },
      "alpha_vantage": {
        "enabled": true,
        "api_key": "${TRADING_ALPHA_VANTAGE_API_KEY}"
      },
      "finnhub": {
        "enabled": true,
        "api_key": "${TRADING_FINNHUB_API_KEY}"
      },
      "nse": {
        "enabled": true,
        "cache_ttl": 1800,
        "comment": "Kenyan NSE via Afristox + Mansa APIs"
      }
    }
  },
  "ensemble_method": "adaptive_confidence",
  "performance_window": 30,
  "rebalance_frequency": 7,
  "strategies": {
    "momentum": {
      "type": "technical",
      "enabled": true,
      "lookback_period": 50,
      "threshold": 0.02,
      "weight": 1.0,
      "max_position_size": 0.05
    },
    "mean_reversion": {
      "type": "technical",
      "enabled": true,
      "lookback_period": 20,
      "weight": 1.0,
      "max_position_size": 0.05
    },
    "rsi_strategy": {
      "type": "technical",
      "enabled": true,
      "rsi_period": 14,
      "rsi_overbought": 70,
      "rsi_oversold": 30,
      "weight": 0.8,
      "max_position_size": 0.05
    }
  },
  "risk_management": {
    "var_confidence": 0.95,
    "max_position_size": 0.05,
    "max_portfolio_var": 0.02,
    "max_drawdown": 0.1,
    "max_daily_loss": 0.03
  },
  "cash_policy": {
    "enabled": true,
    "target_deployment": 0.8,
    "min_cash_buffer": 0.1,
    "base_risk_per_trade": 0.02,
    "max_risk_per_trade": 0.05,
    "min_confidence_to_boost": 0.55
  },
  "sleeve": {
    "enabled": false,
    "nse_capital_kes": 0,
    "capital_split_pct": 0.5,
    "top_n": 5,
    "weighting_mode": "equal",
    "universe": [
      "SCOM",
      "EQTY",
      "KCB",
      "COOP",
      "SCBK",
      "ABSA",
      "BAT",
      "EABL",
      "NCBA"
    ],
    "scoring": {
      "yield_cap_pct": 12.0,
      "yield_weight": 0.5,
      "quality_weight": 0.5,
      "payout_ratio_min": 0.3,
      "payout_ratio_max": 0.7,
      "years_paid_target": 5,
      "min_avg_daily_volume": 50000,
      "stale_days": 400,
      "require_sustainable": true,
      "min_dividend_cover": 1.2,
      "yield_trap_pct": 12.0,
      "min_years_paid": 3,
      "max_per_sector": 2,
      "ex_date_tilt": 0.1
    },
    "sectors": {
      "KCB": "banking",
      "EQTY": "banking",
      "COOP": "banking",
      "SCBK": "banking",
      "ABSA": "banking",
      "SBIC": "banking",
      "NCBA": "banking",
      "SCOM": "telecom",
      "EABL": "consumer",
      "BAT": "consumer",
      "KEGN": "energy",
      "TOTL": "energy",
      "BAMB": "industrial",
      "KNRE": "insurance",
      "BRIT": "insurance",
      "CIC": "insurance",
      "NMG": "media",
      "CTUM": "investment"
    }
  },
  "risk_limits": {
    "max_portfolio_var": 0.02,
    "max_position_size": 0.05,
    "max_drawdown": 0.1,
    "stop_loss_pct": 0.05,
    "trailing_stop_pct": 0.03,
    "stop_loss_atr_mult": 2.5,
    "trailing_stop_atr_mult": 3.0,
    "min_stop_pct": 0.02,
    "max_stop_pct": 0.25,
    "atr_length": 14
  },
  "brokers": {
    "paper_broker": {
      "type": "paper",
      "initial_cash": 100000,
      "commission_per_trade": 1.0,
      "primary": false
    },
    "alpaca_broker": {
      "type": "alpaca",
      "enabled": true,
      "api_key": "${TRADING_ALPACA_API_KEY}",
      "api_secret": "${TRADING_ALPACA_API_SECRET}",
      "paper": true,
      "primary": true
    },
    "coinbase_broker": {
      "type": "coinbase",
      "enabled": false,
      "api_key": "${COINBASE_API_KEY}",
      "secret": "${COINBASE_API_SECRET}",
      "passphrase": "${COINBASE_PASSPHRASE}",
      "is_paper": true
    }
  },
  "trading": {
    "initial_capital": 100000,
    "commission": 0.001,
    "slippage": 0.0005,
    "risk_per_trade": 0.005,
    "_risk_per_trade_note": "Fraction of equity risked per position if its stop is hit. Interacts with risk_limits.max_position_size: with 2.5x ATR stops and a 5% cap, the cap binds below about 4% ATR. Note cash_policy.base_risk_per_trade (0.02) is a separate, older knob that cannot coexist with a 5% cap; reconcile the two before relying on either."
  },
  "trading_loop_interval": 60,
  "nlp": {
    "sentiment_model": "vader",
    "text_processing": {
      "remove_stopwords": true,
      "lemmatize": true
    }
  },
  "automl": {
    "n_trials": 100,
    "cv_folds": 5
  },
  "portfolio_optimization": {
    "risk_free_rate": 0.02,
    "frequency": "daily",
    "lookback_period": 252
  },
  "monitoring": {
    "enabled": true,
    "port": 8080,
    "metrics_interval": 15,
    "system_metrics_enabled": true
  },
  "security": {
    "use_encryption": true,
    "api_key_rotation_days": 90
  },
  "execution": {
    "max_slippage": 0.005,
    "max_order_size": 10000,
    "min_order_size": 100,
    "use_twap": true,
    "twap_duration": 300,
    "slice_size": 0.1
  },
  "analytics": {
    "benchmark": "SPY",
    "risk_free_rate": 0.02,
    "max_history_days": 365,
    "max_trades_history": 10000
  },
  "api": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 5001,
    "debug": false
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/trading_agent.log",
    "max_size_mb": 10,
    "backup_count": 5
  },
  "research_ingest": {
    "enabled": true,
    "upload_dir": "data/research_uploads",
    "auto_follow_rules": {
      "require_existing_symbol": true,
      "allowed_recommendations": [
        "BUY",
        "HOLD",
        "ACCUMULATE"
      ],
      "min_upside_pct": 5.0
    }
  },
  "self_assessment": {
    "assessment_interval": 390
  },
  "swarm": {
    "enabled": true,
    "redis_enabled": true,
    "agents": {
      "pdf_extractor": "meta-llama/llama-3.3-70b-instruct:free",
      "sector_specialist": "meta-llama/llama-3.3-70b-instruct:free",
      "sentiment_analyst": "meta-llama/llama-3.3-70b-instruct:free",
      "synthesizer": "meta-llama/llama-3.3-70b-instruct:free"
    }
  },
  "costs": {
    "_comment": "Per-side transaction costs by market. A single global rate cannot describe this portfolio: Alpaca is commission-free on US equities while an NSE round trip runs several percent. Set verified=true once you have confirmed a schedule with your broker.",
    "us_equity": {
      "commission_pct": 0.0,
      "min_commission": 0.0,
      "slippage_pct": 0.0005,
      "verified": true,
      "note": "Alpaca charges no commission on US equities."
    },
    "nse": {
      "commission_pct": 0.017,
      "min_commission": 0.0,
      "slippage_pct": 0.003,
      "verified": false,
      "note": "PLACEHOLDER \u2014 CONFIRM WITH AIB-AXYS. Brokerage plus CMA levy, NSE levy and CDSC fees. At 1.7% a side the round trip is 3.4%, which decides whether any NSE strategy is viable. Set verified=true after checking."
    },
    "crypto": {
      "commission_pct": 0.006,
      "min_commission": 0.0,
      "slippage_pct": 0.001,
      "verified": false,
      "note": "PLACEHOLDER \u2014 Coinbase taker fees vary by 30-day volume tier."
    }
  },
  "regime_filter": {
    "_comment": "Momentum and mean reversion are opposed on entries. Rather than averaging them into a score neither can clear, let momentum vote only in trends and mean reversion only in ranges; the other abstains. A symbol with fewer than slow_period bars reads as unknown and is not filtered at all.",
    "enabled": true,
    "fast_period": 20,
    "slow_period": 50
  },
  "momentum_rotation": {
    "_comment": "Cross-sectional momentum: rank the universe by 12-1 return, hold the leaders, rebalance monthly. Distinct from the per-symbol `momentum` technical strategy. absolute_filter holds cash rather than buying the best-performing loser in a falling market.",
    "lookback": 12,
    "skip_recent": 1,
    "top_n": 3,
    "min_momentum": 0.0,
    "absolute_filter": true,
    "max_weight": 0.5
  }
}
