{
  "data_manager": {
    "symbols": [
      "AAPL", "GOOGL", "MSFT", "TSLA", "NVDA",
      "SPY", "QQQ", "XLF", "XLV", "XLE", "DIA"
    ],
    "nse_symbols": [
      "SCOM", "EQTY", "KCB", "COOP", "SCBK", "SBIC", "ABSA",
      "BAT", "EABL", "KEGN", "KNRE", "BAMB",
      "TOTL", "CTUM", "NMG", "NCBA", "BRIT", "CIC"
    ],
    "update_interval": 60,
    "max_retries": 3,
    "redis": {
      "host": "localhost",
      "port": 6379,
      "db": 0
    },
    "connectors": {
      "fmp": {
        "enabled": true,
        "api_key": "${TRADING_FMP_API_KEY}"
      },
      "alpha_vantage": {
        "enabled": true,
        "api_key": "${TRADING_ALPHA_VANTAGE_API_KEY}"
      },
      "finnhub": {
        "enabled": true,
        "api_key": "${TRADING_FINNHUB_API_KEY}"
      },
      "nse": {
        "enabled": true,
        "cache_ttl": 1800,
        "comment": "Kenyan NSE via Afristox + Mansa APIs"
      }
    }
  },
  "ensemble_method": "adaptive_confidence",
  "performance_window": 30,
  "rebalance_frequency": 7,
  "strategies": {
    "momentum": {
      "type": "technical",
      "enabled": true,
      "lookback_period": 50,
      "threshold": 0.02,
      "weight": 1.0,
      "max_position_size": 0.05
    },
    "mean_reversion": {
      "type": "technical",
      "enabled": true,
      "lookback_period": 20,
      "weight": 1.0,
      "max_position_size": 0.05
    },
    "rsi_strategy": {
      "type": "technical",
      "enabled": true,
      "rsi_period": 14,
      "rsi_overbought": 70,
      "rsi_oversold": 30,
      "weight": 0.8,
      "max_position_size": 0.05
    }
  },
  "risk_management": {
    "var_confidence": 0.95,
    "max_position_size": 0.05,
    "max_portfolio_var": 0.02,
    "max_drawdown": 0.10,
    "max_daily_loss": 0.03
  },
  "risk_limits": {
    "max_portfolio_var": 0.02,
    "max_position_size": 0.05,
    "max_drawdown": 0.10,
    "stop_loss_pct": 0.05,
    "trailing_stop_pct": 0.03
  },
  "brokers": {
    "paper_broker": {
      "type": "paper",
      "initial_cash": 100000,
      "commission_per_trade": 1.0,
      "primary": false
    },
    "alpaca_broker": {
      "type": "alpaca",
      "enabled": true,
      "api_key": "${TRADING_ALPACA_API_KEY}",
      "api_secret": "${TRADING_ALPACA_API_SECRET}",
      "paper": true,
      "primary": true
    },
    "coinbase_broker": {
      "type": "coinbase",
      "enabled": false,
      "api_key": "${COINBASE_API_KEY}",
      "secret": "${COINBASE_API_SECRET}",
      "passphrase": "${COINBASE_PASSPHRASE}",
      "is_paper": true
    }
  },
  "trading": {
    "initial_capital": 100000,
    "commission": 0.001,
    "slippage": 0.0005
  },
  "trading_loop_interval": 60,
  "nlp": {
    "sentiment_model": "vader",
    "text_processing": {
      "remove_stopwords": true,
      "lemmatize": true
    }
  },
  "automl": {
    "n_trials": 100,
    "cv_folds": 5
  },
  "portfolio_optimization": {
    "risk_free_rate": 0.02,
    "frequency": "daily",
    "lookback_period": 252
  },
  "monitoring": {
    "enabled": true,
    "port": 8080,
    "metrics_interval": 15,
    "system_metrics_enabled": true
  },
  "security": {
    "use_encryption": true,
    "api_key_rotation_days": 90
  },
  "execution": {
    "max_slippage": 0.005,
    "max_order_size": 10000,
    "min_order_size": 100,
    "use_twap": true,
    "twap_duration": 300,
    "slice_size": 0.1
  },
  "analytics": {
    "benchmark": "SPY",
    "risk_free_rate": 0.02,
    "max_history_days": 365,
    "max_trades_history": 10000
  },
  "api": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 5001,
    "debug": false
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/trading_agent.log",
    "max_size_mb": 10,
    "backup_count": 5
  },
  "research_ingest": {
    "enabled": true,
    "upload_dir": "data/research_uploads",
    "auto_follow_rules": {
      "require_existing_symbol": true,
      "allowed_recommendations": ["BUY", "HOLD", "ACCUMULATE"],
      "min_upside_pct": 5.0
    }
  },
  "self_assessment": {
    "assessment_interval": 390
  },
  "swarm": {
    "enabled": true,
    "redis_enabled": true,
    "agents": {
      "pdf_extractor": "anthropic/claude-sonnet-4.6",
      "sector_specialist": "anthropic/claude-sonnet-4.6",
      "sentiment_analyst": "meta-llama/llama-3.3-70b-instruct",
      "synthesizer": "deepseek/deepseek-r1"
    }
  }
}