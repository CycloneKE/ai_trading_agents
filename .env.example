# Environment variables for AI Trading Agent
# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# --- Required ---
# JWT signing key. Without this the API fails closed (all routes 503) —
# this is intentional, not a bug: see src/api/api_server.py.
SECRET_KEY=change_me_to_a_long_random_string

# --- Recommended: market data (dashboard/strategies degrade without these) ---
TRADING_FMP_API_KEY=your_fmp_api_key_here
TRADING_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
TRADING_FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Recommended: paper broker (Alpaca paper trading) ---
TRADING_ALPACA_API_KEY=your_alpaca_paper_api_key_here
TRADING_ALPACA_API_SECRET=your_alpaca_paper_api_secret_here

# --- Optional: Coinbase broker (disabled by default in config/config.json) ---
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=

# --- Optional: OANDA broker (not configured by default) ---
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# --- Optional: LLM validation/allocation (trade veto + strategy weighting) ---
# Only one of these needs to be set; see src/agent/llm_orchestrator.py.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Monitoring (:8080) ---
# Dedicated password for /metrics and /status — deliberately never falls
# back to SECRET_KEY (that would put a JWT signing key over plaintext
# HTTP-adjacent basic auth). /health stays open for container healthchecks.
MONITORING_PASSWORD=change_me_too

# --- Dashboard CORS ---
# Must include every origin traders actually browse to, comma-separated.
# Defaults to localhost:3000,localhost:3001 if unset.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# --- Redis (optional; falls back to in-process state if unset/unreachable) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- API hardening (all have sane defaults; override only if needed) ---
API_RATE_LIMIT=100
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
TOKEN_TTL_HOURS=8
TRUST_PROXY=false
